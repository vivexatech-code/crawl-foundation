# NEXT.JS ENVIRONMENT VARIABLES FOR NGO WEBSITE

# Default Tenant Slug
NEXT_PUBLIC_DEFAULT_NGO_SLUG=the-crawl-foundation

# Supabase (PostgreSQL with RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Razorpay Payment Gateway (Server-Side)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxx

# Resend Transactional Email System
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=donations@thecrawlfoundation.org

# Cloudinary Media Storage (Optional)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
